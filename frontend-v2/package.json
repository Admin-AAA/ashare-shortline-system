{
  "name": "ashare-shortline-frontend-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "generate:api": "cd ../backend && .venv/bin/python -m scripts.export_openapi && cd ../frontend-v2 && openapi-typescript /tmp/ashare-openapi.json -o src/api/schema.generated.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^0.508.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.3",
    "vite": "^8.1.3"
  }
}
