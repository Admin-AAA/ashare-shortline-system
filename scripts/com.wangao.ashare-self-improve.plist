<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.wangao.ashare-self-improve</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/wangao/Desktop/ashare-shortline-system/scripts/run-self-improve.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/wangao/Desktop/ashare-shortline-system</string>
    <!-- 每小时触发一次（3600 秒）。回测/前端 build 慢可调到 7200（2 小时）-->
    <key>StartInterval</key>
    <integer>3600</integer>
    <!-- 装载时不立刻跑，等下一个整点。改 true 则 launchctl load 后立即跑一次 -->
    <key>RunAtLoad</key>
    <false/>
    <!-- 定时任务，不是常驻服务：跑完退出，等下次触发 -->
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/wangao/Library/Logs/ashare-self-improve.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/wangao/Library/Logs/ashare-self-improve.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <key>HOME</key>
      <string>/Users/wangao</string>
    </dict>
  </dict>
</plist>
