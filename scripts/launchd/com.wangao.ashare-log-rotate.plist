<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>com.wangao.ashare-log-rotate</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/wangao/Desktop/ashare-shortline-system/scripts/launchd/rotate_ashare_logs.sh</string>
	</array>
	<!-- 每周日 03:30（交易时段与 17:35 日更之外） -->
	<key>StartCalendarInterval</key><dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
	<key>StandardOutPath</key><string>/Users/wangao/Library/Logs/ashare-log-rotate.out.log</string>
	<key>StandardErrorPath</key><string>/Users/wangao/Library/Logs/ashare-log-rotate.out.log</string>
</dict>
</plist>
